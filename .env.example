# Get a free key at https://console.groq.com/keys
# Copy this file to .env (or just export it) to enable live LLM-powered
# profile extraction, coaching, and job-description parsing. Without it,
# Saarthi AI automatically falls back to rule-based heuristics so the app
# still runs end-to-end for local testing / grading.
GROQ_API_KEY=

# Optional override. Default is openai/gpt-oss-20b (fast, free-tier).
# openai/gpt-oss-120b is a larger/higher-quality option on the same tier.
# Note: llama-3.3-70b-versatile and llama-3.1-8b-instant were deprecated
# by Groq in June 2026 — don't use those model names.
GROQ_MODEL=openai/gpt-oss-20b

PORT=8000
